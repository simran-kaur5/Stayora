<% layout("/layouts/boilerplate.ejs") %>

<div class="row mt-3">
    <div class="col-8 offset-2">
        <h3>Edit your Listings</h3>
        <form action="/listings/<%= list._id %>?_method=PATCH" method="POST">
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input type="text" name="title" class="form-control" value="<%= list.title %>" >
            </div>
            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea type="text" name="description" class="form-control" id="" ><%=list.description%></textarea>
            </div>
            
            <div class="mb-3">
                <label for="image" class="form-label">Image</label>
                <input type="url" name="image" id="" class="form-control" value="<%= list.image.url %>">
            </div>

            <div class="row">

                <div class="mb-3 col-md-4">
                    <label for="price" class="form-label">Price</label>
                    <input type="text" name="price" id="" class="form-control" value="<%= list.price %>">
                </div>
                
                <div class="mb-3 col-md-8">
                    <label for="country" class="form-label">Country</label>
                    <input type="text" name="country" id="" class="form-control" value="<%= list.country %>">
                </div>
            </div>

            <div class="mb-3">
                <label for="location" class="form-label">Location</label>
                <input type="'text'" name="location" id="" class="form-control" value="<%= list.location %>">
            </div>

            
            <button class="btn btn-dark edit-btn mt-3">Edit</button>
        </form>
        </div>

</div>
</html>