<% layout("/layouts/boilerplate.ejs") %>
<style>
    .show-img {
        width: 100%;
    }

    .btns {
        display: flex;
        gap: 1rem;
        margin-left: 25%;
    }
    .map-section {
        width: 100%;
    }


    #map {
    width: 100%;
    height: 300px;
    border-radius: 15px;
    }

    @media (max-width: 767px) {

        .show-title {
            margin-left: 0;
        }

        .show-card {
            width: 100%;
            margin: 0;
        }

        .btns {
            margin-left: 0;
            display: flex;
            gap: 1rem;
        }

        .btns .edit-btn {
            width: auto;
        }

        .review-section {
            width: 100%;
            margin: 0;
        }

        .review-card {
            width: 100%;
            margin-left: 0 !important;
        }

        #map {
            height: 300px;
        }
    }

    @media (max-width: 767px) {
    .map-section {
        width: 100%;
        margin-left: 0;
    }

    #map {
        width: 100%;
        height: 300px;
        border-radius: 15px;
    }
}
</style>

<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const listing = <%- JSON.stringify(list) %>
</script>
<div class="row mt-3">
    <div class="col-8 offset-3 show-title">
        <h2><%= list.title %></h2>
    </div>
    <div class="card col-6 offset-3 show-card listing-card">
        <img src="<%= list.image.url %>"class="card-img-top show-img" alt="Listing_image">
        <div class="card-body">
            <p class="card-text">Owned by <b><i><%= list.owner.username %></i></b></p>
                
                <p class="card-text"><%=  list.description%></p>
                <p class="card-text">&#8377;<%=  list.price.toLocaleString("en-IN")%></p>
                <p class="card-text"><%= list.location %></p>
                <p class="card-text"><%= list.country %></p>

        </div>
        </div>
        <br>
        <% if (currUser && currUser._id.equals(list.owner._id)) { %>
            <div class="btns">
                <a href="/listings/<%= list._id %>/edit" class="btn btn-dark edit-btn">
                    Edit
                </a>

                <form action="/listings/<%= list._id %>?_method=DELETE" method="POST">
                    <button class="btn btn-dark">Delete</button>
                </form>
            </div>
        <% } %>
                 
    
    <% if (currUser) { %>
     
    <div class="col-8 offset-3 review-section">
        <br>
        <h4>Leave a Review</h4>
        <form action="/listings/<%= list._id%>/reviews" method = "POST" class="needs-validation" novalidate>
            <div class="mb-3 mt-3">
                <label for="rating" class="form-label">Rating</label>
                <fieldset class="starability-slot">
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>
            <div class="mb-3">
                <label for="comment" class="form-label">Comment</label>
                <textarea name="review[comment]" id="comment" rows="5" cols="30" class="form-control" required></textarea>
                <div class="invalid-feedback">
                    Please submit some comments for Review
                </div>
            </div>
            <button class="btn btn-outline-dark">Submit</button>
        </form>
        <hr>

        <% } %>
        <% if (list.reviews.length > 0) { %>
        <div class="row">
            <p><b>All Reviews</b></p>

            <% for( let review of list.reviews) { %>
                <div class="card col-5 ms-3 mb-3 review-card">
                    <div class="card-body">
                        <h5 class="card-title">@<%= review.author.username %></h5>
                        <p class="starability-result card-text" data-rating=<%= review.rating %>></p>
                        <p class="card-text"><%=review.comment%></p>
                    </div>
                    <form action="/listings/<%=list._id%>/reviews/<%=review._id%>?_method=DELETE" method = "POST" class="mb-3 mt-3">
                        <button class="btn btn-sm btn-dark">Delete</button>
                    </form>
                </div>
                <% } %>
            
            </div>
            <% } %>

    </div>
    <div class="col-12 col-md-6 offset-md-3 mb-3 map-section">
                <h3>Where you'll be</h3>
                <div id="map"></div>
            </div>    
            <script src="/js/map.js"></script>
     </div>

     