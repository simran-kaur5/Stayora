<% layout("/layouts/boilerplate.ejs") %>
<body>
    <h3>You Listings</h3>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
        <% for(let list of listing) { %>
            <a href="/listings/<%=list._id%>" class="listing-link">
                <div class="card col listing-card">
                    <img src="<%=list.image.url%>" class="card-img-top" alt="lisitng_images" style="height: 20rem;">
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                        <p class="card-text"></p>
                            <b><%= list.title %></b>
                            <br>
                            Price: &#8377;<%=  list.price.toLocaleString("en-IN")%>/night
                        </p>
                    </div>
                </div>
            </a>
    <% } %>
    </div>
</body>
</html>