<% layout("/layouts/boilerplate.ejs") %>

<div class="chat-page">

    <div class="chat-container">

        <!-- Chat Header -->
        <div class="chat-header">
            <div>
                <h3>Ask Stayora</h3>
                <p>Your AI travel assistant</p>
            </div>

            <a href="/listings" class="close-chat">
                <i class="fa-solid fa-xmark"></i>
            </a>
        </div>
        <div class="chat-messages">

            <div class="message ai-message">

                <div class="message-content">
                    Hi! 👋 I'm Stayora AI.
                    <br>
                    Tell me what kind of stay you're looking for.
                </div>
            </div>

        </div>

        <!-- Chat Input -->
        <form class="chat-input-area" action="/chat" method="POST">

            <input
                type="text"
                class="chat-input"
                placeholder="Ask me anything about your stay..."
                name="message"
            >

            <button type="submit" class="send-btn">
                <i class="fa-solid fa-paper-plane"></i>
            </button>

        </form>

    </div>

</div>


<style>
body{
    background: #f5f5f5;
}
.chat-page {
    height: calc(100vh - 80px);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1rem;
    box-sizing: border-box;
}

.chat-container {
    width: 720px;
    height: 670px;
    border: 1px solid #dedede;
    border-radius: 22px;
    overflow: hidden;
    background: #ffffff;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.12);

    display: flex;
    flex-direction: column;
}


/* Header */

.chat-header {
    background: #111111;
    color: white;
    padding: 1.3rem 1.5rem;

    display: flex;
    justify-content: space-between;
    align-items: center;
}

.chat-header h3 {
    margin: 0;
    font-weight: 600;
}

.chat-header p {
    margin: 4px 0 0;
    font-size: 0.85rem;
    color: #bdbdbd;
}

.close-chat {
    color: white;
    font-size: 1.3rem;
    text-decoration: none;
    transition: 0.2s;
}

.close-chat:hover {
    opacity: 0.7;
    transform: scale(1.1);
}


/* Messages */

.chat-messages {
    flex: 1;
    padding: 1.5rem;
    overflow-y: auto;
    background: #fafafa;
}

.message {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 1rem;
}

.message-content {
    background: #eeeeee;
    color: #171717;
    padding: 0.8rem 1rem;
    border-radius: 16px;
    max-width: 80%;
    line-height: 1.5;
}


/* User Message */

.user-message {
    justify-content: flex-end;
}

.user-message .message-content {
    background: #111111;
    color: white;
}


/* Input */

.chat-input-area {
    display: flex;
    padding: 1rem;
    border-top: 1px solid #dedede;
    gap: 10px;
    background: white;
}

.chat-input {
    flex: 1;
    border: 1px solid #d5d5d5;
    border-radius: 25px;
    padding: 0.75rem 1rem;
    outline: none;
    font-size: 0.95rem;
    transition: 0.2s;
}

.chat-input:focus {
    border-color: #111111;
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.06);
}

.send-btn {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    border: none;

    background: #111111;
    color: white;

    cursor: pointer;
    transition: 0.2s;
}

.send-btn:hover {
    background: #333333;
    transform: scale(1.05);
}


/* Mobile */

@media (max-width: 600px) {

    .chat-page {
        padding: 0.5rem;
    }

    .chat-container {
        width: 100%;
        height: 75vh;
        border-radius: 15px;
    }

}


</style>

<script>
    const chatForm = document.querySelector(".chat-input-area");
    const chatInput = document.querySelector(".chat-input");
    const chatMessages = document.querySelector(".chat-messages");

    chatForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        const message = chatInput.value.trim();

        if (!message) return;

        // Show user's message
        const userMessage = document.createElement("div");
        userMessage.classList.add("message", "user-message");

        userMessage.innerHTML = `
            <div class="message-content">
                ${message}
            </div>
        `;

        chatMessages.appendChild(userMessage);

        // Clear input
        chatInput.value = "";

        // Scroll to bottom
        chatMessages.scrollTop = chatMessages.scrollHeight;

        const response = await fetch("/chat", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                message: message
            })
        });
        
        const html = await response.text();
        const aiMessage = document.createElement("div");
        aiMessage.classList.add("message", "ai-message");

        aiMessage.innerHTML = `
            <div class="message-content">
                ${html}
            </div>
        `;

        chatMessages.appendChild(aiMessage);

        chatMessages.scrollTop = chatMessages.scrollHeight;
    });
</script>