<% layout("/layouts/boilerplate.ejs") %>

<div class="row mt-3">
    <h1 class="col-6 offset-3">SignUp on Stayora</h1>
    <div class="col-6 offset-3">
        <form action="/signup" method="POST">
            <div class="mb-3">
            <label for="username" class="form-label" class="needs-validation" novalidate>Username</label>
            <input type="text" class="form-control" name="username" id="username" placeholder="Username" required>
            <div class="valid-feedback">Looks Good</div>
        </div>

        <div class="mb-3">
            <label for="email" class="form-label" class="needs-validation" novalidate>Email</label>
            <input type="text" class="form-control" name="email" id="email" placeholder="Email" required>
        </div>
        <div class="mb-3">
            <label for="password" class="form-label" class="needs-validation" novalidate>Password</label>
            <input type="password" class="form-control" name="password" id="password" placeholder="password" required>
        </div>
        <button class="btn btn-success">Sign Up</button>
        </form>
    </div>
</div>