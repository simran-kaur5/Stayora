    margin-left: 0.5rem; 
    } 
    .navbar-actions {
    margin-top: 0.5rem;
    } } 
  @media (max-width: 400px) {
    .search-form {
    flex-direction: column; 
    gap: 0.5rem;
    } 
    .search-btn { 
    width: 100%; margin-left: 0; 
  } } 
