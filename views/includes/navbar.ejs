
<style> 
  .search-btn {
    background-color: #fe424d; 
    color: #ffffff; 
    border-radius: 25px; 
    padding: 0.5rem 1rem;

    margin-left: 0.5rem; 
    white-space: nowrap; 
  }
  .search-btn:hover 
  { 
      background-color: #fe424d; 
    color: #ffffff; } 
    .search-btn i { 
    margin-right: 0.5rem;
  } 
  .search-inp {
    border-radius: 25px;
    padding: 0.5rem 1.5rem; 
    font-size: 1rem;
    width: 280px; 
  } 

