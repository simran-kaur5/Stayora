
<style> 
  .container-fluid {
    position: relative;
    flex-wrap: nowrap !important;
}
  .search-form {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
  }
  .search-btn {
    background-color: #fe424d; 
    color: #ffffff; 
    border-radius: 25px; 
    padding: 0.5rem 1rem;

    margin-left: 0.5rem; 
    white-space: nowrap; 
  }
  .search-btn:hover 
  { 
      background-color: #fe424d; 
    color: #ffffff; } 
    .search-btn i { 
    margin-right: 0.5rem;
  } 
  .search-inp {
    border-radius: 25px;
    padding: 0.5rem 1.5rem; 
    font-size: 1rem;
    width: 280px; 
  } 

  .menu-icon {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.menu-icon span {
    width: 20px;
    height: 2px;
    background: #333;
    display: block;
    transition: 0.2s;
}

.navbar-toggler[aria-expanded="true"] .menu-icon span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
}

.navbar-toggler[aria-expanded="true"] .menu-icon span:nth-child(2) {
    opacity: 0;
}

.navbar-toggler[aria-expanded="true"] .menu-icon span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
}

  .navbar-toggler {
    background-color: #fff !important;
    border: 1px solid #ddd !important;
    border-radius: 8px !important;
    padding: 6px 10px !important;
}

.navbar-toggler:focus {
    background-color: #fff !important;
    box-shadow: none !important;
}

.navbar-toggler-icon {
    background-color: #fff !important;
}
  @media (max-width: 767px) {

    .navbar-toggler {
        flex-shrink: 0;
    }

    .search-form {
        position: static;
        transform: none;
        margin-left: auto;
        margin-right: 0.5rem;
        flex-shrink: 1;
    }

    .search-inp {
        width: 120px;
    }

    .search-btn {
        font-size: 0;
        padding: 0.5rem 0.7rem;
        flex-shrink: 0;
    }

    .search-btn i {
        font-size: 1rem;
        margin-right: 0;
    }
     .navbar-collapse {
        position: absolute;
        top: 100%;
        right: 0;
        width: 200px;
        background: white;
        padding: 1rem;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .navbar-collapse .navbar-nav {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
    }
}
</style>
<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
    <div class="container-fluid">

        <!-- Logo -->
        <a class="navbar-brand" href="/listings">
            <i class="fa-solid fa-compass"></i>
        </a>

        <!-- Explore - ALWAYS VISIBLE -->
        <div class="navbar-nav">
            <a class="nav-link" href="/listings">
                Explore
            </a>
        </div>

        <!-- Search -->
        <form class="d-flex search-form" role="search">
            <input
                class="form-control search-inp"
                type="search"
                placeholder="Search destination">

            <button class="btn search-btn" type="submit">
                <i class="fa-solid fa-magnifying-glass"></i>
                Search
            </button>
        </form>

        <!-- Hamburger -->
        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNavAltMarkup"
            aria-controls="navbarNavAltMarkup"
            aria-expanded="false"
            aria-label="Toggle navigation">

            <span class="menu-icon">
              <span></span>
              <span></span>
              <span></span>
          </span>
        </button>

        <!-- RIGHT SIDE OPTIONS -->
        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">

            <div class="navbar-nav ms-auto text-end">

                <a class="nav-link" href="/listings/new">
                    Airbnb your home
                </a>

                <% if (!currUser) { %>

                    <a class="nav-link" href="/signup">
                        <b>Sign Up</b>
                    </a>

                    <a class="nav-link" href="/login">
                        <b>Login</b>
                    </a>

                <% } %>

                <% if(currUser) { %>

                    <a class="nav-link" href="/logout">
                        <b>Logout</b>
                    </a>

                <% } %>

            </div>

        </div>

    </div>
</nav>